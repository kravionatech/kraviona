# The server falls back to ../backend/.env when these are omitted.
MONGO_URI=mongodb://127.0.0.1:27017/kraviona
DB_NAME=kraviona

# Optional direct URI fallback for environments that cannot resolve Atlas SRV.
MONGO_DIRECT_URI=

# Only these backend roles can create/use an MCP session. Keep super_admin for
# complete business control; widening this list is a deliberate security choice.
MCP_ADMIN_ROLES=super_admin
MCP_ADMIN_SESSION_DAYS=30

# Optional overrides. By default the login CLI writes .admin-session locally.
MCP_ADMIN_SESSION_FILE=
MCP_ADMIN_SESSION_TOKEN=

# Optional non-interactive inputs for `npm run login`. Do not commit values.
MCP_ADMIN_IDENTIFIER=
MCP_ADMIN_PASSWORD=

# Local stdio is the default. Vercel should explicitly use Streamable HTTP.
MCP_TRANSPORT=
# PORT=3000

# Claude Chat remote connector OAuth. Set MCP_PUBLIC_URL to the stable Vercel
# production domain, without a trailing slash. Claude dynamically registers as
# a public PKCE client, so a client ID/secret is normally unnecessary.
MCP_PUBLIC_URL=
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
MCP_OAUTH_ACCESS_TOKEN_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_DAYS=30
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# Legacy service-to-service HTTP access. Not needed by the Claude connector.
MCP_API_KEY=

# Safety policy. Writes are enabled; permanent deletion is disabled by default.
MCP_READ_ONLY=false
MCP_ALLOW_DELETES=false
MCP_DB_TIMEOUT_MS=10000

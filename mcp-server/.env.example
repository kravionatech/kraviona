# Optional override. The MCP server falls back to ../backend/.env.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=kraviona

# Set true for a completely read-only Claude connection.
MCP_READ_ONLY=false

# Permanent delete tools are blocked unless this is explicitly true.
MCP_ALLOW_DELETES=false

# Optional MongoDB server-selection timeout in milliseconds (1000-60000).
MCP_DB_TIMEOUT_MS=10000

# Required only for the remote Vercel /mcp endpoint. Generate at least 32
# random bytes and store the value in Vercel, never in this file.
MCP_API_KEY=

# Required for Claude web connector OAuth authorization.
MCP_OAUTH_PASSWORD=

# Canonical public origin, without a trailing slash.
MCP_PUBLIC_URL=https://mcpserver.kraviona.com

# Optional public OAuth client ID. The default works with Claude DCR.
MCP_OAUTH_CLIENT_ID=claude-web

{
  "name": "kraviona-admin-mcp",
  "version": "3.0.0",
  "description": "Private super-admin MCP server for managing the complete Kraviona backend with native Mongoose schemas and audited mutations",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "postinstall": "npm ci --prefix ../backend --omit=dev",
    "login": "node scripts/login.js",
    "logout": "node scripts/logout.js",
    "whoami": "node scripts/whoami.js",
    "check": "node scripts/check.js",
    "tools": "node scripts/list-tools.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "slugify": "^1.6.9"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "private": true
}

# Existing backend settings
MONGO_URI=mongodb://127.0.0.1:27017/kraviona
DB_NAME=kraviona
PORT=5000
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Comma-separated frontend/admin origins allowed to call this API.
# Enter origins only (no path); a trailing slash is normalized automatically.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://kraviona.com,https://admin.kraviona.com,https://superadmin.kraviona.com

# Blog Web Push. Generate once with: npx web-push generate-vapid-keys
# Keep the private key only in the backend deployment environment.
WEB_PUSH_VAPID_SUBJECT=mailto:kravionatech@gmail.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
